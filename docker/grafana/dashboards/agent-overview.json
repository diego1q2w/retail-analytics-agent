{
  "uid": "ra-agent-overview",
  "title": "Agent overview",
  "tags": [
    "retail-analytics",
    "agent"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": false,
  "links": [
    {
      "title": "MLflow traces",
      "type": "link",
      "url": "http://127.0.0.1:55500/#/experiments/0/traces",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to use this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Metrics here carry **no identifiers**. To follow one run, take its `run_id` (shown in every progress event and API response) and run `python -m retail_analytics.bootstrap.trace_lookup <run_id>` for the MLflow trace link and id. In MLflow, all spans of a run share one trace: API acceptance, workflow steps, tool calls, query attempts (BigQuery job id), model attempts (provider, model, attempt, fallback) and the run root (answering provider). A fresh clone shows data after the first runs with telemetry on (the default)."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runs finished",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ra_runs_total[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Non-completed share",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ra_runs_total{status=~\"failed|partial|cancelled\"}[$__range])) / clamp_min(sum(increase(ra_runs_total[$__range])), 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Failed, partial or cancelled runs over all finished runs. A valid empty result is not a failure."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(ra_runs_total[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{status}}"

# Copy to .env (ignored by Git) and fill in locally. Never commit real values.
# Process environment variables override values in .env. Empty means unset.
#
# Lines starting with "# NAME=value" document a setting at its built-in default.
# ./scripts/bootstrap.sh does not copy them into .env, so a changed default
# reaches you automatically. Uncomment one only to override it on purpose.
# Uncommented lines below are setup values: credentials, generated secrets and
# local stack addresses.

# live (default): real analysis; requires settings marked "required in live".
# fixture: opt-in offline wiring check with fixed responses, not real analysis.
# APP_MODE=live

# APP_API_HOST=127.0.0.1
# APP_API_PORT=8080
# ARTIFACT_DIR=data/local/artifacts
# Byte limits per stored artifact (Markdown reports; images/PDF for later).
# ARTIFACT_MAX_MARKDOWN_BYTES=1048576
# ARTIFACT_MAX_BINARY_BYTES=10485760

# required in live. For the local Compose stack (see README, "Local services"):
#   postgresql+psycopg://retail_app:local-only-app@127.0.0.1:55442/retail_app
APP_DATABASE_URL=
# Where investigations execute (independent of APP_MODE):
#   local (default): inside the API process; PostgreSQL only, no Temporal and no
#     worker. Disconnecting the CLI keeps a run going; stopping the API
#     interrupts its runs (they are marked interrupted, never resumed).
#   temporal (opt-in): durable Temporal workflows run by retail-analytics-worker;
#     ./scripts/bootstrap.sh and ./scripts/dev.sh then start Temporal and the worker.
# Switch only when no investigation is active (startup refuses otherwise).
# EXECUTION_BACKEND=local
# local backend: investigations executing at once (1-64), and seconds shutdown
# waits for them before marking them interrupted (0-300)
# LOCAL_MAX_CONCURRENT_RUNS=4
# LOCAL_SHUTDOWN_GRACE_SECONDS=10
# Temporal backend only (ignored with local). Local Compose stack: 127.0.0.1:57233
TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=retail-analytics
# required in live: the Google Cloud project that runs (and pays for) query jobs
GOOGLE_CLOUD_PROJECT=
# BigQuery job location; must match the dataset, not the model endpoint.
# GOOGLE_CLOUD_LOCATION=US
# seconds source schema metadata is trusted before re-reading (60-86400)
# SCHEMA_REFRESH_SECONDS=3600
# seconds an executed result may be reused automatically for current-data questions (60-86400)
# EVIDENCE_CURRENT_FRESHNESS_SECONDS=900
# days to keep minimal audit events (1-3650)
# AUDIT_RETENTION_DAYS=90
# most reports and expired investigations one cleanup run handles (1-10000)
# CLEANUP_BATCH_SIZE=100
# required in live
GEMINI_API_KEY=
# model for the credential check (generateContent); the agent uses AGENT_GEMINI_MODEL
# GEMINI_MODEL=gemini-3-flash-preview
# optional backup provider (GPT through the OpenAI Responses API); empty = no fallback
OPENAI_API_KEY=

# Investigation agent models (live mode); see docs/model-providers.md.
# Gemini primary through the Interactions API; OpenAI backup.
# AGENT_GEMINI_MODEL=gemini-3.8-flash
# AGENT_OPENAI_MODEL=gpt-5-mini
# seconds to the first streamed token (5-600); a progressing stream is not cut at this limit
# MODEL_FIRST_TOKEN_SECONDS=60
# seconds without any streamed event after the first one (5-600)
# MODEL_STREAM_STALL_SECONDS=30
# seconds per provider request in total (30-1800, >= first-token limit)
# MODEL_REQUEST_MAX_SECONDS=180
# seconds requests skip a failed primary and go to the backup (0-3600)
# MODEL_PRIMARY_COOLDOWN_SECONDS=60
# output token cap per provider request, reasoning included (256-65536)
# MODEL_MAX_OUTPUT_TOKENS=8192
# Price overrides for exact model names, USD per million tokens, as one-line JSON:
#   {"my-model": {"input": 0.75, "cached_input": 0.075, "output": 3.75}}
# Empty = the maintained price list (genai-prices) only. A model it does not know
# has an UNKNOWN price: with RUN_MAX_MODEL_COST_USD > 0 its requests are refused.
# MODEL_PRICE_OVERRIDES=

# Golden retrieval. Default: gemini in live mode, hashing in fixture mode.
# hashing = offline deterministic embedder (fixture mode, or explicit opt-in in
# live mode with its own thresholds); gemini = Gemini embeddings (needs the
# Gemini key; free tier is rate limited). Live mode never falls back to hashing
# by itself. Stored vectors are keyed by model and dimensions, never mixed.
# Changing the model or dimensions needs both thresholds below.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
# up to 3 examples; per-channel candidates before fusion; relevance thresholds.
# Empty thresholds = measured defaults for the provider: gemini 0.70 / 0.75
# (tuning split), hashing 0.55 / 0.5 (offline scale, not measured).
# Cosine scales depend on the embedding model: remeasure if you change it.
# SEMANTIC_WEIGHT is the weighted-RRF weight of the semantic channel (keyword = 1).
# RETRIEVAL_MAX_RESULTS=3
# RETRIEVAL_CHANNEL_CANDIDATES=10
# RETRIEVAL_MIN_SIMILARITY=
# RETRIEVAL_MIN_LEXICAL_COVERAGE=
# RETRIEVAL_SEMANTIC_WEIGHT=2.0

# Currency conversion: public ECB reference rates via Frankfurter (no key, no quota)
# EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev/v2
# Currency of the dataset amounts, DECLARED by the operator (ISO 4217), never verified
# or inferred from prices. Empty = unknown: conversions are refused. Local default USD.
SOURCE_CURRENCY_DECLARED=USD

# Run budgets: starting limits per investigation (pinned when a run starts;
# changes apply to new runs only). Active time is a hard deadline on a run's
# work (30-86400 s); it excludes waiting for the user's clarification and
# in-flight model/tool work is cut off when it runs out. Every job submission
# counts as a query; every provider request (fallback included) counts as a
# request; tokens = reported input + output.
# RUN_ACTIVE_SECONDS=120
# RUN_MAX_PROVIDER_REQUESTS=20
# RUN_MAX_TOKENS=100000
# Soft limit on ESTIMATED model spend per investigation, USD (0 = off). Covers
# every provider attempt, retry and fallback; checked before each request, so
# the request that crosses it can overshoot. Estimates, not provider invoices;
# BigQuery and infrastructure costs are not included (they keep the limits below).
# RUN_MAX_MODEL_COST_USD=1
# RUN_MAX_QUERIES=10
# bytes scanned: 1 GiB per query, 5 GiB per run (query <= run)
# QUERY_MAX_BYTES=1073741824
# RUN_MAX_BYTES=5368709120
# reformulations of one failed query; total attempts allowed to fail transiently
# QUERY_MAX_CORRECTIONS=2
# MAX_TRANSIENT_ATTEMPTS=3
# exponential backoff with jitter between transient attempts (seconds)
# RETRY_BASE_SECONDS=1.0
# RETRY_MAX_SECONDS=20.0
# warehouse query deadline (seconds), then cancel and reconcile
# QUERY_DEADLINE_SECONDS=120
# per tool result, whichever comes first; truncation is always flagged
# RESULT_MAX_ROWS=500
# RESULT_MAX_BYTES=262144

# Local simulated authentication (HS256 tokens). The signing key is required by
# the API and the dev-access token command; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_ISSUER=retail-analytics-local
# AUTH_AUDIENCE=retail-analytics-api
AUTH_SIGNING_KEY=

# Telemetry (best effort; a backend outage only drops telemetry): MLflow traces
# (OTLP/HTTP protobuf) and Prometheus metrics (its OTLP receiver). Start the
# stack with: docker compose up -d --wait postgres mlflow prometheus grafana
# (./scripts/bootstrap.sh and ./scripts/dev.sh do it by default). On by default;
# set false to opt out (bootstrap never overwrites an explicit false).
# TELEMETRY_ENABLED=true
# TELEMETRY_TRACES_ENDPOINT=http://127.0.0.1:55500/v1/traces
# TELEMETRY_METRICS_ENDPOINT=http://127.0.0.1:59090/api/v1/otlp/v1/metrics
# TELEMETRY_EXPERIMENT_ID=0
# Optional: use a separate existing MLflow experiment for HTTP traces.
# Unset disables HTTP trace export; HTTP metrics remain enabled.
# TELEMETRY_HTTP_EXPERIMENT_ID=
# TELEMETRY_EXPORT_TIMEOUT_SECONDS=2
# TELEMETRY_METRIC_INTERVAL_SECONDS=10
# Sanitized interaction content in MLflow traces (model messages and responses,
# tool arguments/results, SQL, the request, clarifications and the released
# answer; personal data and secrets masked, sizes bounded). Even masked, traces
# hold analytical data: keep MLflow operator-only. false keeps metadata only.
# TELEMETRY_CAPTURE_CONTENT=true

# Master key (>= 32 bytes) for opaque customer/order/item references in query
# results. Never commit or log it; rotating it retires every existing reference.
# Unset: customer-level references are unavailable (queries fail closed).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
REFERENCE_KEY=

# Local Compose stack (compose.yaml; read by Docker Compose, not by the app).
# scripts/bootstrap.sh generates the database passwords for a new volume; empty
# means the throwaway defaults in compose.yaml. They only take effect when the
# postgres volume is first created.
COMPOSE_POSTGRES_PORT=55442
COMPOSE_TEMPORAL_PORT=57233
COMPOSE_APP_DB_PASSWORD=
COMPOSE_TEMPORAL_DB_PASSWORD=
COMPOSE_PG_ADMIN_PASSWORD=

# CLI client settings (the CLI never holds backend credentials)
# CLI_API_URL=http://127.0.0.1:8080
# CLI_TIMEOUT_SECONDS=10
# The access token: set one of these (the file wins). Never printed by the CLI.
# Local development: retail-analytics-dev-access token demo-a > ~/.analytics-token
# CLI_TOKEN=
# CLI_TOKEN_FILE=

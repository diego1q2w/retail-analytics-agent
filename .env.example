# Copy to .env (ignored by Git) and fill in locally. Never commit real values.
# Process environment variables override values in .env. Empty means unset.

# fixture (default): offline, deterministic fakes, no credentials needed.
# live: requires every setting marked "required in live".
RETAIL_ANALYTICS_MODE=fixture

RETAIL_ANALYTICS_API_HOST=127.0.0.1
RETAIL_ANALYTICS_API_PORT=8080
RETAIL_ANALYTICS_ARTIFACT_DIR=data/local/artifacts
# Byte limits per stored artifact (Markdown reports; images/PDF for later).
RETAIL_ANALYTICS_ARTIFACT_MAX_MARKDOWN_BYTES=1048576
RETAIL_ANALYTICS_ARTIFACT_MAX_BINARY_BYTES=10485760

# required in live. For the local Compose stack (see README, "Local services"):
#   postgresql+psycopg://retail_app:local-only-app@127.0.0.1:55442/retail_app
RETAIL_ANALYTICS_DATABASE_URL=
# required in live. Local Compose stack: 127.0.0.1:57233
RETAIL_ANALYTICS_TEMPORAL_ADDRESS=
RETAIL_ANALYTICS_TEMPORAL_NAMESPACE=default
RETAIL_ANALYTICS_TEMPORAL_TASK_QUEUE=retail-analytics
# required in live: the Google Cloud project that runs (and pays for) query jobs
RETAIL_ANALYTICS_BIGQUERY_PROJECT=
RETAIL_ANALYTICS_BIGQUERY_LOCATION=US
# seconds source schema metadata is trusted before re-reading (60-86400)
RETAIL_ANALYTICS_SCHEMA_REFRESH_SECONDS=3600
# seconds an executed result may be reused automatically for current-data questions (60-86400)
RETAIL_ANALYTICS_EVIDENCE_CURRENT_FRESHNESS_SECONDS=900
# required in live
RETAIL_ANALYTICS_GEMINI_API_KEY=
# default model for the credential check; model selection proper is a later task
RETAIL_ANALYTICS_GEMINI_MODEL=gemini-3-flash-preview
# optional fallback provider
RETAIL_ANALYTICS_OPENAI_API_KEY=

# Golden retrieval. hashing = offline deterministic embedder (fixture mode);
# gemini = Gemini embeddings (needs the Gemini key; free tier is rate limited).
RETAIL_ANALYTICS_EMBEDDING_PROVIDER=hashing
RETAIL_ANALYTICS_EMBEDDING_MODEL=gemini-embedding-2
RETAIL_ANALYTICS_EMBEDDING_DIMENSIONS=768
# up to 3 examples; per-channel candidates before fusion; relevance thresholds
RETAIL_ANALYTICS_RETRIEVAL_MAX_RESULTS=3
RETAIL_ANALYTICS_RETRIEVAL_CHANNEL_CANDIDATES=10
RETAIL_ANALYTICS_RETRIEVAL_MIN_SIMILARITY=0.55
RETAIL_ANALYTICS_RETRIEVAL_MIN_LEXICAL_COVERAGE=0.5

# Currency conversion: public ECB reference rates via Frankfurter (no key, no quota)
RETAIL_ANALYTICS_EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev/v2
# Currency of the dataset amounts, DECLARED by the operator (ISO 4217), never verified
# or inferred from prices. Empty = unknown: conversions are refused. Local default USD.
RETAIL_ANALYTICS_SOURCE_CURRENCY_DECLARED=USD

# Local simulated authentication (HS256 tokens). The signing key is required by
# the API and the dev-access token command; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RETAIL_ANALYTICS_AUTH_ISSUER=retail-analytics-local
RETAIL_ANALYTICS_AUTH_AUDIENCE=retail-analytics-api
RETAIL_ANALYTICS_AUTH_SIGNING_KEY=

# Master key (>= 32 bytes) for opaque customer/order/item references in query
# results. Never commit or log it; rotating it retires every existing reference.
# Unset: customer-level references are unavailable (queries fail closed).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RETAIL_ANALYTICS_REFERENCE_KEY=

# Local Compose stack (compose.yaml; read by Docker Compose, not by the app).
# scripts/bootstrap.sh generates the database passwords for a new volume; empty
# means the throwaway defaults in compose.yaml. They only take effect when the
# postgres volume is first created.
COMPOSE_POSTGRES_PORT=55442
COMPOSE_TEMPORAL_PORT=57233
COMPOSE_APP_DB_PASSWORD=
COMPOSE_TEMPORAL_DB_PASSWORD=
COMPOSE_PG_ADMIN_PASSWORD=

# CLI client settings (the CLI never holds backend credentials)
ANALYTICS_CLI_API_URL=http://127.0.0.1:8080
ANALYTICS_CLI_TIMEOUT_SECONDS=10
